{
    "name": "code-quality-test-suite/php",
    "description": "PHP 格式化 + Lint 实测套件（PHP-CS-Fixer + PHPStan + php_codesniffer）",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/phpstan": "^2.3.3",
        "squizlabs/php_codesniffer": "^4.0.4"
    },
    "scripts": {
        "cs:check": "phpcs --standard=phpcs.xml.dist",
        "cs:fixer": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "phpstan": "phpstan analyse -c phpstan.neon --no-progress"
    }
}
