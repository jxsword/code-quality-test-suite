<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.qcts</groupId>
  <artifactId>java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>code-quality-test-suite :: Java</name>
  <description>google-java-format(Spotless) + Checkstyle 14.3.0 实测套件</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- JDK 17 -->
    <maven.compiler.release>17</maven.compiler.release>
    <!-- 工具版本锁（与 2026-10-28 调研一致） -->
    <spotless.version>3.10.4</spotless.version>
    <google-java-format.version>1.37.0</google-java-format.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <!--
      用 checkstyle 14.3.0：maven-checkstyle-plugin 不提供 checkstyle.version 属性，
      因此按官方文档在插件 <dependencies> 内覆盖（见 build 段）。
    -->
    <checkstyle.version>14.3.0</checkstyle.version>
  </properties>

  <build>
    <plugins>
      <!-- 编译：release 17 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>

      <!-- 格式化：google-java-format（Spotless），CI/pre-commit 跑 spotless:check -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- 风格/命名/Lint：Checkstyle 14.3.0（插件依赖覆盖版本） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${maven-checkstyle-plugin.version}</version>
        <dependencies>
          <!-- 覆盖插件自带的 checkstyle 版本为 14.3.0 -->
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>checkstyle.xml</configLocation>
          <failsOnError>true</failsOnError>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
